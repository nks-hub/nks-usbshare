<Window x:Class="NksUsbShare.Desktop.SettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings" Height="360" Width="500"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ShowInTaskbar="False"
        TextOptions.TextFormattingMode="Display">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="150" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Text="This computer:" VerticalAlignment="Center" Margin="0,0,0,10" />
        <TextBox   Grid.Row="0" Grid.Column="1" x:Name="NameBox" Margin="0,0,0,10" Padding="4,3" />

        <TextBlock Grid.Row="1" Grid.Column="0" Text="Listen on address:" VerticalAlignment="Center" Margin="0,0,0,4" />
        <ComboBox  Grid.Row="1" Grid.Column="1" x:Name="BindBox" IsEditable="True" Margin="0,0,0,4" Padding="4,3">
            <ComboBoxItem Content="0.0.0.0" />
            <ComboBoxItem Content="127.0.0.1" />
        </ComboBox>

        <TextBlock Grid.Row="2" Grid.Column="1" Margin="0,0,0,10" TextWrapping="Wrap" Foreground="#767676"
                   Text="0.0.0.0 accepts connections from the network. 127.0.0.1 keeps the node to this computer." />

        <TextBlock Grid.Row="3" Grid.Column="0" Text="Listen on port:" VerticalAlignment="Center" Margin="0,0,0,12" />
        <TextBox   Grid.Row="3" Grid.Column="1" x:Name="PortBox" Width="90" HorizontalAlignment="Left"
                   Margin="0,0,0,12" Padding="4,3" />

        <CheckBox Grid.Row="4" Grid.Column="1" x:Name="RequireCertificateBox" Margin="0,0,0,6">
            <TextBlock Text="Clients must present a key this computer already knows" TextWrapping="Wrap" />
        </CheckBox>

        <TextBlock Grid.Row="5" Grid.Column="1" TextWrapping="Wrap" Foreground="#767676" VerticalAlignment="Top"
                   Text="With this on, knowing the pairing token is not enough: a client also has to have paired before, so a leaked token alone cannot be used." />

        <StackPanel Grid.Row="6" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="OK" IsDefault="True" Click="OnOk" MinWidth="86" Margin="0,0,8,0" />
            <Button Content="Cancel" IsCancel="True" MinWidth="86" Margin="0" />
        </StackPanel>
    </Grid>
</Window>
