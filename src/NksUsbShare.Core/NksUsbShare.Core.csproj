<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>latest</LangVersion>
    <RootNamespace>NksUsbShare.Core</RootNamespace>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <EnableDefaultCompileItems>true</EnableDefaultCompileItems>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Carried inside the assembly so a published binary can hand a device to WinUSB without
         anything else being installed alongside it.

         The file under tools/ is the only copy. It used to be duplicated here, the two drifted
         apart, and the application quietly shipped the stale one while the repaired script sat
         next to it unused. The logical name keeps the resource id the code looks up. -->
    <EmbeddedResource Include="..\..\tools\bind-winusb.ps1"
                      LogicalName="NksUsbShare.Core.Usb.Windows.bind-winusb.ps1" />
  </ItemGroup>

</Project>
