<Window x:Class="NksUsbShare.Desktop.AddHostDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add computer" Height="248" Width="440"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ShowInTaskbar="False"
        TextOptions.TextFormattingMode="Display">

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="112" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.ColumnSpan="2" TextWrapping="Wrap" Margin="0,0,0,12"
                   Text="Enter the address of the other computer and the pairing token it shows under Connection details." />

        <TextBlock Grid.Row="1" Grid.Column="0" Text="Address:" VerticalAlignment="Center" Margin="0,0,0,8" />
        <TextBox   Grid.Row="1" Grid.Column="1" x:Name="AddressBox" Margin="0,0,0,8" Padding="4,3" />

        <TextBlock Grid.Row="2" Grid.Column="0" Text="Port:" VerticalAlignment="Center" Margin="0,0,0,8" />
        <TextBox   Grid.Row="2" Grid.Column="1" x:Name="PortBox" Width="90" HorizontalAlignment="Left"
                   Margin="0,0,0,8" Padding="4,3" />

        <TextBlock Grid.Row="3" Grid.Column="0" Text="Pairing token:" VerticalAlignment="Center" />
        <TextBox   Grid.Row="3" Grid.Column="1" x:Name="TokenBox" FontFamily="Consolas" Padding="4,3" />

        <StackPanel Grid.Row="5" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="OK" IsDefault="True" Click="OnOk" MinWidth="86" Margin="0,0,8,0" />
            <Button Content="Cancel" IsCancel="True" MinWidth="86" Margin="0" />
        </StackPanel>
    </Grid>
</Window>
