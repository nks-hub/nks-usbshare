<Window x:Class="NksUsbShare.Desktop.AccessDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Who can use this device" Height="420" Width="560"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        TextOptions.TextFormattingMode="Display">

    <DockPanel Margin="16">

        <TextBlock DockPanel.Dock="Top" x:Name="DeviceLabel" FontWeight="SemiBold" Margin="0,0,0,10" />

        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <RadioButton x:Name="AnyoneOption" GroupName="Access" Margin="0,0,0,4"
                         Content="Any computer that knows the pairing token" Checked="OnScopeChanged" />
            <RadioButton x:Name="ChosenOption" GroupName="Access"
                         Content="Only the computers ticked below" Checked="OnScopeChanged" />
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="OK" IsDefault="True" Click="OnOk" MinWidth="86" Margin="0,0,8,0" />
            <Button Content="Cancel" IsCancel="True" MinWidth="86" Margin="0" />
        </StackPanel>

        <TextBlock DockPanel.Dock="Bottom" x:Name="EmptyNote" Margin="0,8,0,0" TextWrapping="Wrap"
                   Foreground="#767676" Visibility="Collapsed"
                   Text="No computer has connected yet, so there is nobody to choose. Pair one first, then come back." />

        <ListView x:Name="ClientList" SelectionMode="Single">
            <ListView.View>
                <GridView>
                    <GridViewColumn Width="30">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding Allowed, Mode=TwoWay}" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="Computer" Width="160" DisplayMemberBinding="{Binding Name}" />
                    <GridViewColumn Header="Key fingerprint" Width="200" DisplayMemberBinding="{Binding Fingerprint}" />
                    <GridViewColumn Header="Last seen" Width="110" DisplayMemberBinding="{Binding LastSeen}" />
                </GridView>
            </ListView.View>
        </ListView>

    </DockPanel>
</Window>
